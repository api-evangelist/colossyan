                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{experimentalBaseUrl}}/knowledge-to-draft/generate-draft",
              "host": [
                "{{experimentalBaseUrl}}"
              ],
              "path": [
                "knowledge-to-draft",
                "generate-draft"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Experimental endpoint that generates a video draft from a knowledge source. Served from the non-versioned base URL and subject to change."
          },
          "response": []
        }
      ]
    }
  ]
}
