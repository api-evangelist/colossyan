{
  "opencollection": "1.0.0",
  "info": {
    "name": "Colossyan Avatars Voices API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Voices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List voices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.colossyan.com/api/v1/assets/voices"
          },
          "docs": "Returns the AI voices available for narration across the platform's supported languages."
        }
      ]
    }
  ],
  "bundled": true
}